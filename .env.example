# Salin file ini menjadi backend/.env lalu isi SERPAPI_API_KEY.
# JANGAN memasukkan API key asli ke file ini atau ke Git.

# API key SerpApi (https://serpapi.com/dashboard). Hanya dibaca oleh backend.
SERPAPI_API_KEY=

# Port backend Express.
PORT=3001

# Origin frontend yang diizinkan CORS. Pisahkan dengan koma bila lebih dari satu.
CLIENT_ORIGIN=http://localhost:5173

# Ukuran unggahan maksimum dalam MB. Image API SerpApi membatasi 500 KB,
# jadi nilai di atas ~0.47 otomatis dipotong ke batas provider.
MAX_UPLOAD_MB=0.5
